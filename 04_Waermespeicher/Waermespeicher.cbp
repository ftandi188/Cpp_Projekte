<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Waermespeicher" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="DebugWindows">
				<Option output="bin/Debug/Waermespeicher" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="./" />
				</Compiler>
				<Linker>
					<Add library="gdi32" />
					<Add library="user32" />
					<Add library="kernel32" />
					<Add library="comctl32" />
				</Linker>
			</Target>
			<Target title="DebugLinux">
				<Option output="bin/Debug/Kessel" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="`pkg-config gtk+-2.0 --cflags`" />
					<Add option="-Wno-deprecated-declarations" />
					<Add directory="./" />
				</Compiler>
				<Linker>
					<Add option="`pkg-config gtk+-2.0 --libs`" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++11" />
		</Compiler>
		<Linker>
			<Add option="-pthread" />
		</Linker>
		<Unit filename="Boiler.cpp" />
		<Unit filename="Boiler.h" />
		<Unit filename="Burner.cpp" />
		<Unit filename="Burner.h" />
		<Unit filename="Point.cpp" />
		<Unit filename="Point.h" />
		<Unit filename="Stages.h" />
		<Unit filename="WinAdapt.cpp" />
		<Unit filename="WinAdapt.h" />
		<Unit filename="main.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
